     #         </summary>
     #         <div class="records">
     #           <article class="record" id="record-id1">
     #             <div class="record-header">
     #               <span class="record-id">
     #                 id1
     #               </span>
     #               <span class="badge">
     #                 2×
     #               </span>
     #             </div>
     #             <div class="issues">
     #               <section class="issue">
     #                 <div class="issue-title">
     #                   Error #1
     #                 </div>
     #                 <div class="params">
     #                   <span class="param">
     #                     <span class="param-key">
     #                       <b>
     #                         key
     #                       </b>
     #                     </span>
     #                     <span class="param-separator">
     #                       :
     #                     </span>
     #                     <code class="param-value">
     #                       <span class="param-value-text">value                      </span>
     #                     </code>
     #                   </span>
     #                 </div>
     #               </section>
     #               <section class="issue">
     #                 <div class="issue-title">
     #                   Error #2
     #                 </div>
     #                 <div class="params">
     #                   <span class="param">
     #                     <span class="param-key">
     #                       <b>
     #                         key
     #                       </b>
     #                     </span>
     #                     <span class="param-separator">
     #                       :
     #                     </span>
     #                     <code class="param-value">
     #                       <span class="param-value-text">value                      </span>
