     #         pluginů s chybou
     #       </span>
     #     </article>
     #     <article class="panel stat">
     #       <strong>
     #         1
     #       </strong>
     #       <span>
     #         zasažených záznamů
     #       </span>
     #     </article>
     #     <article class="panel stat">
     #       <strong>
     #         2
     #       </strong>
     #       <span>
     #         celkem chyb
     #       </span>
     #     </article>
     #   </section>
     #   <section class="content-grid">
     #     <div class="plugin-list">
     #       <details class="panel plugin" id="foo" open="open">
     #         <summary>
     #           <div>
     #             <div class="plugin-title">
     #               <h2>
     #                 foo
     #               </h2>
     #               <span class="badge">
     #                 2 chyb
     #               </span>
     #               <span class="badge">
     #                 1 záznamů
     #               </span>
     #             </div>
     #             <div class="module">
     #               MARC::Validator::Plugin::Foo · v0.01 · 2026-10-23T17:10:26
