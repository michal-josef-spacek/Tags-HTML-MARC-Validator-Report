NAME
    Tags::HTML::MARC::Validator::Report - Tags helper class for MARC
    validator report presentation.

SYNOPSIS
     use Tags::HTML::MARC::Validator::Report;

     my $obj = Tags::HTML::MARC::Validator::Report->new(%params);
     $obj->cleanup;
     $obj->init($report);
     $obj->prepare;
     $obj->process;
     $obj->process_css;

METHODS
  "new"
     my $obj = Tags::HTML::MARC::Validator::Report->new(%params);

    Constructor.

    *       "css_class"

            CSS class for the report root element.

            Default value is 'marc-validator-report'.

    *       "css"

            CSS::Struct::Output object.

            Default value is undef.

    *       "tags"

            Tags::Output object.

            Default value is undef.

    Returns instance of object.

  "cleanup"
     $obj->cleanup;

    Process cleanup after page run and remove the initialized report object.

    Returns undef.

  "init"
     $obj->init($report);

    Initialize the component for a page run. Takes a
    Data::MARC::Validator::Report object as $report.

    Returns undef.

  "prepare"
     $obj->prepare;

    Process initialization before page run.

    It is not used in this module.

    Returns undef.

  "process"
     $obj->process;

    Process the initialized MARC validator report into a Tags structure. The
    output is rooted in a "div" with the configured CSS class and contains
    report statistics, plugin sections, records, and validation issues.

    Returns undef.

  "process_css"
     $obj->process_css;

    Process the component CSS into a CSS::Struct structure. Selectors are
    scoped below the configured report CSS class.

    Returns undef.

ERRORS
     new():
             From Class::Utils::set_params():
                     Unknown parameter '%s'.
             From Tags::HTML::new():
                     Parameter 'css' must be a 'CSS::Struct::Output::*' class.
                     Parameter 'tags' must be a 'Tags::Output::*' class.

     init():
             Not valid 'Data::MARC::Validator::Report' object.

     process():
             From Tags::HTML::process():
                     Parameter 'tags' isn't defined.

     process_css():
             From Tags::HTML::process_css():
                     Parameter 'css' isn't defined.

EXAMPLE1
     use strict;
     use warnings;

     use CSS::Struct::Output::Indent;
     use Data::MARC::Validator::Report;
     use Data::MARC::Validator::Report::Error;
     use Data::MARC::Validator::Report::Plugin;
     use Data::MARC::Validator::Report::Plugin::Errors;
     use DateTime;
     use Tags::HTML::MARC::Validator::Report;
     use Tags::Output::Indent;

     # Output objects.
     my $css = CSS::Struct::Output::Indent->new;
     my $tags = Tags::Output::Indent->new;
     my $obj = Tags::HTML::MARC::Validator::Report->new(
             'css' => $css,
             'tags' => $tags,
     );

     # Report data.
     my $report = Data::MARC::Validator::Report->new(
             'datetime' => DateTime->now,
             'plugins' => [
                     Data::MARC::Validator::Report::Plugin->new(
                             'plugin_errors' => [
                                     Data::MARC::Validator::Report::Plugin::Errors->new(
                                             'errors' => [
                                                     Data::MARC::Validator::Report::Error->new(
                                                             'error' => 'Error #1',
                                                             'params' => {
                                                                     'key' => 'value',
                                                             },
                                                     ),
                                                     Data::MARC::Validator::Report::Error->new(
                                                             'error' => 'Error #2',
                                                             'params' => {
                                                                     'key' => 'value',
                                                             },
                                                     ),
                                             ],
                                             'filters' => ['filter1', 'filter2'],
                                             'record_id' => 'id1',
                                     ),
                             ],
                             'module_name' => 'MARC::Validator::Plugin::Foo',
                             'name' => 'foo',
                             'version' => '0.01',
                     ),
             ],
     );

     # Process HTML and CSS.
     $obj->init($report);
     $obj->process;
     $obj->process_css;

     print "HTML:\n";
     print $tags->flush;
     print "\n\n";
     print "CSS:\n";
     print $css->flush;

     # Output:
     # HTML:
     # <div class="marc-validator-report">
     #   <section class="stats">
     #     <article class="panel stat">
